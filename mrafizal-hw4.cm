    queue_tail = queue_tail + 1;
    signal(lunch_queue_mux);
    signal(prepare_lunch_queue);

    wait(lunch_ready2);
    Delay(); 
    wait(print_mux);
    cout << "D2 eats, go work" << endl;
    signal(print_mux);
    signal(all_eaten_work);

    // Wait until can come home (after SW eats apple)
    wait(can_come_home);
    Delay(); // Random delay to create race condition
    
    // Try to be first home
    wait(home_mux);
    if (first_home_dwarf == 0) {
        // I'm first!
        first_home_dwarf = 2;
        signal(home_mux);
        
        wait(print_mux);
        cout << "D2 comes home" << endl;
        signal(print_mux);
        Delay();
        wait(print_mux);
        cout << "D2 finds SW dead" << endl;
        signal(print_mux);
        Delay();
        wait(print_mux);
        cout << "D2 calls others" << endl;
        signal(print_mux);
        
        // Signal other dwarfs to come home
        signal(called_others);
        signal(called_others);
        
        // Wait for other dwarfs to arrive
        wait(others_arrive);
        wait(others_arrive);
        
        // Count myself as arrived
        wait(arrival_mux);
        dwarfs_arrived = dwarfs_arrived + 1;
        if (dwarfs_arrived == 3) {
            // Last to register arrival, signal all can put in casket
            signal(all_arrived);
            signal(all_arrived);
            signal(all_arrived);
        }
        signal(arrival_mux);
        
        // Wait until all have arrived before putting in casket
        wait(all_arrived);
        
        Delay(); 
        wait(print_mux);
        cout << "D2 puts SW in casket" << endl;
        signal(print_mux);
    } else {
        // Not first, I was called
        signal(home_mux);
        wait(called_others);
        
        Delay();
        wait(print_mux);
        cout << "D2 comes home" << endl;
        signal(print_mux);
        signal(others_arrive);
        
        // Count myself as arrived
        wait(arrival_mux);
        dwarfs_arrived++;
        if (dwarfs_arrived == 3) {
            // Last to register arrival, signal all can put in casket
            signal(all_arrived);
            signal(all_arrived);
            signal(all_arrived);
        }
        signal(arrival_mux);
        
        // Wait until all have arrived before putting in casket
        wait(all_arrived);
        
        Delay(); 
        wait(print_mux);
        cout << "D2 puts SW in casket" << endl;
        signal(print_mux);
    }
}

