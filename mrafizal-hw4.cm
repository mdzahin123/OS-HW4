// ---------------- Main ----------------
void main() {
    DELAY = 50;

    wait(print_mux);
    cout << "Once upon time, lived  lovely little princess named SW ." << endl;  // Story begins
    signal(print_mux);

    cobegin {
        Queen();
        Huntsman();
        SnowWhite();
        OldPeddler();
        Dwarf1();
        Dwarf2();
        Dwarf3();
    }

    wait(print_mux);
    cout << "To be continued." << endl;  // Story ending (to be continued with Prince)
    signal(print_mux);
}
